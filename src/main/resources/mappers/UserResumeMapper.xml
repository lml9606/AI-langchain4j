<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.langchain4j.repository.mapper.UserResumeMapper">

    <resultMap id="UserResumeMap" type="com.example.langchain4j.repository.entity.UserResume">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 每用户仅一份：user_id 唯一约束冲突时覆盖 title/content（原子 upsert，无并发竞态） -->
    <insert id="upsert" parameterType="com.example.langchain4j.repository.entity.UserResume">
        INSERT INTO ai_user_resume (user_id, title, content, created_at, updated_at)
        VALUES (#{userId}, #{title}, #{content}, now(), now())
        ON CONFLICT (user_id) DO UPDATE SET
            title      = EXCLUDED.title,
            content    = EXCLUDED.content,
            updated_at = now()
    </insert>

    <select id="selectByUserId" resultMap="UserResumeMap">
        SELECT id, user_id, title, content, created_at, updated_at
        FROM ai_user_resume
        WHERE user_id = #{userId}
    </select>
</mapper>
