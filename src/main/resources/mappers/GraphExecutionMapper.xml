<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.langchain4j.repository.mapper.GraphExecutionMapper">

    <resultMap id="GraphExecutionMap" type="com.example.langchain4j.repository.entity.GraphExecution">
        <id property="id" column="id"/>
        <result property="executionId" column="execution_id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="nodeName" column="node_name"/>
        <result property="status" column="status"/>
        <result property="inputJson" column="input_json"/>
        <result property="outputJson" column="output_json"/>
        <result property="errorMsg" column="error_msg"/>
        <result property="costMs" column="cost_ms"/>
        <result property="rootCause" column="root_cause"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.langchain4j.repository.entity.GraphExecution"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_graph_execution
            (execution_id, conversation_id, node_name, status, input_json, output_json, error_msg, cost_ms, root_cause)
        VALUES
            (#{executionId}, #{conversationId}, #{nodeName}, #{status}, #{inputJson}, #{outputJson}, #{errorMsg}, #{costMs}, #{rootCause})
    </insert>

    <select id="selectByConversationId" resultMap="GraphExecutionMap">
        SELECT id, execution_id, conversation_id, node_name, status, input_json, output_json, error_msg, cost_ms, root_cause, created_at
        FROM ai_graph_execution
        WHERE conversation_id = #{conversationId}
        ORDER BY id DESC
        LIMIT #{limit}
    </select>
</mapper>
